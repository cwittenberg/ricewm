{
  "$schema": "ricewm.theme/v2",
  "name": "Orchard",
  "version": 1,
  "description": "Airy blue and white, softly frosted sidebars, and clear rounded controls.",
  "appearance": {
    "chrome.profile": "orchard",
    "material": "liquid-glass",
    "corner.radius": "18",
    "sidebar.material": "glass",
    "taskbar.bar": "e6f0fa",
    "taskbar.ridge": "ffffff",
    "taskbar.start": "007aff",
    "taskbar.task": "f5f9ff",
    "taskbar.tray": "dceaf7",
    "taskbar.text": "1d2935",
    "accent": "0088ff",
    "icon": "1679bd",
    "icon.hover": "0069d9",
    "icon.variant": "monochrome",
    "icon.overrides": "",
    "menu.background": "edf5fc",
    "menu.alternate": "ffffff",
    "menu.separator": "c7d6e3",
    "menu.hover": "0088ff",
    "menu.selected": "0088ff",
    "menu.text": "1d2935",
    "frame.active": "f1f7fd",
    "frame.inactive": "f6f9fc",
    "frame.border": "aebdcb",
    "frame.body": "ffffff",
    "frame.text": "1d2935",
    "frame.control": "e7edf3",
    "frame.close": "ff5f57",
    "frame.pressed": "0088ff",
    "menu.material": "glass"
  },
  "background": {
    "type": "gradient",
    "start": "#e3f0ff",
    "middle": "#b5d9ff",
    "end": "#80baff",
    "accent": "#0088ff"
  },
  "settings": {
    "dock.style": "Compact dock",
    "dock.height": "Comfortable",
    "appearance.animations": "true",
    "appearance.animations.elastic": "false",
    "appearance.windows.rounded": "true",
    "appearance.windows.active_shadow": "true",
    "appearance.menus.shadow": "true",
    "appearance.frosted_ice.enabled": "true",
    "appearance.frosted_ice.panels": "true",
    "appearance.frosted_ice.menus": "true",
    "appearance.frosted_ice.system": "true",
    "appearance.frosted_ice.windows": "true",
    "appearance.frosted_ice.pointer_light": "false",
    "appearance.frosted_ice.window_content_pointer_light": "false",
    "appearance.frosted_ice.ricewm_menu_pointer_light": "false",
    "appearance.frosted_ice.thickness": "36",
    "appearance.frosted_ice.opacity": "68",
    "appearance.frosted_ice.blur": "72",
    "appearance.frosted_ice.refraction": "36",
    "appearance.frosted_ice.chroma": "6",
    "appearance.frosted_ice.window_border": "24",
    "appearance.frosted_ice.widget_border": "65",
    "appearance.frosted_ice.widgets.buttons": "true",
    "appearance.frosted_ice.widgets.switches": "true",
    "appearance.frosted_ice.widgets.sliders": "true",
    "appearance.frosted_ice.widgets.scrollbars": "false",
    "dock.magnification": "false"
  }
}
