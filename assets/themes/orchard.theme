{
  "$schema": "ricewm.theme/v2",
  "name": "Orchard",
  "version": 1,
  "description": "A complete Orchard desktop: clear glass, unified navigation, colorful icons and coordinated light and dark appearances.",
  "appearance": {
    "chrome.profile": "orchard",
    "material": "liquid-glass",
    "corner.radius": "14",
    "sidebar.material": "glass",
    "taskbar.bar": "e6f0fa",
    "taskbar.ridge": "ffffff",
    "taskbar.start": "007aff",
    "taskbar.task": "f5f9ff",
    "taskbar.tray": "dceaf7",
    "taskbar.text": "202126",
    "accent": "0088ff",
    "icon": "535965",
    "icon.hover": "007aff",
    "icon.variant": "color",
    "icon.overrides": "",
    "menu.background": "ffffff",
    "menu.alternate": "ffffff",
    "menu.separator": "c7d6e3",
    "menu.hover": "0088ff",
    "menu.selected": "0088ff",
    "menu.text": "202126",
    "frame.active": "f5f5f7",
    "frame.inactive": "ededf0",
    "frame.border": "c6c6cc",
    "frame.body": "ffffff",
    "frame.text": "202126",
    "frame.control": "ffffff",
    "frame.close": "ff5f57",
    "frame.pressed": "0088ff",
    "menu.material": "glass"
  },
  "background": {
    "type": "image",
    "source": "/usr/share/ricewm/wallpapers/orchard-day.svg",
    "mode": "Crop"
  },
  "settings": {
    "dock.style": "Compact dock",
    "dock.height": "Comfortable",
    "appearance.animations": "true",
    "appearance.animations.elastic": "false",
    "appearance.windows.rounded": "true",
    "appearance.windows.active_shadow": "true",
    "appearance.menus.shadow": "true",
    "appearance.frosted_ice.enabled": "true",
    "appearance.frosted_ice.panels": "true",
    "appearance.frosted_ice.menus": "true",
    "appearance.frosted_ice.system": "true",
    "appearance.frosted_ice.windows": "true",
    "appearance.frosted_ice.pointer_light": "false",
    "appearance.frosted_ice.window_content_pointer_light": "false",
    "appearance.frosted_ice.ricewm_menu_pointer_light": "false",
    "appearance.frosted_ice.thickness": "24",
    "appearance.frosted_ice.opacity": "78",
    "appearance.frosted_ice.blur": "72",
    "appearance.frosted_ice.refraction": "14",
    "appearance.frosted_ice.chroma": "2",
    "appearance.frosted_ice.window_border": "16",
    "appearance.frosted_ice.widget_border": "28",
    "appearance.frosted_ice.widgets.buttons": "true",
    "appearance.frosted_ice.widgets.switches": "true",
    "appearance.frosted_ice.widgets.sliders": "true",
    "appearance.frosted_ice.widgets.scrollbars": "false",
    "dock.magnification": "true",
    "dock.top_bar.visible": "true",
    "dock.top_bar.transparent": "true",
    "dock.launcher.visible": "true",
    "dock.magnification.zoom": "28",
    "dock.magnification.spread": "38",
    "dock.top_bar.layout": "{\"version\":1,\"tooltips\":true,\"items\":[{\"key\":\"@applications\",\"visible\":true,\"position\":0,\"icon\":\"ricewm-logo\"},{\"key\":\"@network\",\"visible\":true,\"position\":2,\"icon\":\"network\"},{\"key\":\"@audio\",\"visible\":true,\"position\":2,\"icon\":\"audio\"},{\"key\":\"@battery\",\"visible\":true,\"position\":2,\"icon\":\"battery\"},{\"key\":\"@search\",\"visible\":true,\"position\":2,\"icon\":\"search\"},{\"key\":\"@session\",\"visible\":true,\"position\":2,\"icon\":\"settings\"},{\"key\":\"@clock\",\"visible\":true,\"position\":2,\"icon\":\"clock\"}]}"
  },
  "shellAppearance": {
    "menuBar": {
      "mode": "application",
      "showAppName": true
    },
    "menu": {
      "fontSize": 13,
      "fontWeight": 400,
      "rootWidth": 270,
      "cascadeWidth": 240
    },
    "launcher": {
      "width": 36,
      "icon": "ricewm-logo",
      "iconSize": 20
    },
    "dock": {
      "folders": true
    }
  },
  "typography": {
    "family": "system",
    "titleFamily": "system",
    "bodyPx": 13,
    "smallPx": 11,
    "titlePx": 13,
    "bodyWeight": 400,
    "titleWeight": 600,
    "lineHeightPercent": 125
  },
  "metrics": {
    "titlebarHeight": 38,
    "controlHeight": 28,
    "menuRowHeight": 26,
    "cornerRadius": 7,
    "controlPaddingX": 10,
    "controlPaddingY": 5,
    "scrollbarWidth": 10,
    "scrollbarArrowSize": 0,
    "scrollbarInset": 2,
    "scrollbarThumbMin": 28,
    "tabHeight": 30,
    "tabPaddingX": 14,
    "tabGap": 3,
    "focusWidth": 2,
    "borderWidth": 1,
    "sliderTrackHeight": 4,
    "sliderThumbWidth": 18,
    "sliderThumbHeight": 18,
    "checkboxSize": 15,
    "radioSize": 15,
    "switchWidth": 34,
    "switchHeight": 21,
    "switchInset": 2
  },
  "windowDecorations": {
    "controlBoxPosition": "Left",
    "controlOrder": [
      "close",
      "minimize",
      "maximize"
    ],
    "controlBoxEdgeInset": 12,
    "titleAlignment": "center",
    "showTitleIcon": false,
    "frameBorderWidth": 1,
    "captionWidth": 20,
    "captionHeight": 20,
    "captionGap": 2
  },
  "treeView": {
    "expander": "chevron",
    "lines": "none",
    "indent": 18,
    "expanderSize": 10,
    "rootLines": false
  },
  "surfaceSkins": {
    "button": {
      "normal": {
        "background": "#ffffffb8",
        "radius": 7,
        "border": {
          "color": "#00000015",
          "width": 1
        }
      },
      "hover": {
        "background": "#0000000b"
      },
      "pressed": {
        "background": "#007aff30"
      }
    },
    "toolbarButton": {
      "normal": {
        "background": "transparent",
        "radius": 7
      },
      "hover": {
        "background": "#0000000b"
      },
      "pressed": {
        "background": "#007aff30"
      }
    },
    "input": {
      "normal": {
        "background": "#ffffffcc",
        "radius": 7,
        "border": {
          "color": "#00000015",
          "width": 1
        }
      }
    },
    "menu": {
      "normal": {
        "background": "#fafafaf0",
        "foreground": "#242429",
        "radius": 10,
        "border": {
          "color": "#00000015",
          "width": 1
        }
      }
    },
    "menuItem": {
      "normal": {
        "radius": 5
      },
      "selected": {
        "background": "#007aff",
        "foreground": "#ffffff"
      },
      "hover": {
        "background": "#007aff",
        "foreground": "#ffffff"
      }
    },
    "notification": {
      "normal": {
        "background": "#fafafaf0",
        "foreground": "#242429",
        "radius": 16,
        "border": {
          "color": "#00000015",
          "width": 1
        }
      }
    },
    "navigationItem": {
      "normal": {
        "radius": 6
      },
      "selected": {
        "background": "#00000010"
      }
    },
    "runningIndicator": {
      "normal": {
        "background": "#42424a",
        "radius": 2
      },
      "selected": {
        "background": "#25252a",
        "radius": 2
      }
    },
    "scrollbarTrackVertical": {
      "normal": {
        "background": "transparent"
      }
    },
    "scrollbarTrackHorizontal": {
      "normal": {
        "background": "transparent"
      }
    },
    "scrollbarThumbVertical": {
      "normal": {
        "background": "#00000050",
        "radius": 5
      }
    },
    "scrollbarThumbHorizontal": {
      "normal": {
        "background": "#00000050",
        "radius": 5
      }
    },
    "windowTitle": {
      "normal": {
        "background": "#f4f4f6f0",
        "foreground": "#777780",
        "radius": 0,
        "border": {
          "color": "#0000000c",
          "width": 1,
          "edges": [
            "bottom"
          ]
        }
      },
      "selected": {
        "background": "#fbfbfcf0",
        "foreground": "#1d1d20"
      }
    }
  },
