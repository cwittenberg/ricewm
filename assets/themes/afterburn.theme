  "appViewsEnabled": true,
  "defaultWallpaper": "signal-yellow",
  "extensions": [
    {
      "uuid": "session-console@ricewm",
      "required": true,
      "settings": {}
    }
  ],
  "motion": {
    "window.open": {
      "preset": "Curtain",
      "duration": 640
    },
    "window.close": {
      "preset": "Curtain",
      "duration": 360
    },
    "menu.open": {
      "preset": "Curtain",
      "duration": 132
    },
    "menu.close": {
      "preset": "Curtain",
      "duration": 96
    },
    "menu.fold": {
      "preset": "Fold",
      "duration": 150
    },
    "notification.open": {
      "preset": "Curtain",
      "duration": 420
    },
    "notification.close": {
      "preset": "Curtain",
      "duration": 240
    },
    "deck.open": {
      "preset": "Slide",
      "duration": 260
    },
    "deck.close": {
      "preset": "Slide",
      "duration": 180
    },
    "hover": {
      "preset": "Slide",
      "duration": 140,
      "easing": "ease-out",
      "keyframes": [
        {
          "at": 0,
          "x": -5,
          "opacity": 0.78
        },
        {
          "at": 1,
          "x": 0,
          "opacity": 1
        }
      ]
    },
    "deck.switch": {
      "preset": "Fade",
      "duration": 160
    }
  },
  "deck": [
    "dashboard",
    "applications",
    "workspaces",
    "controls",
    "wallpapers",
    "notes",
    "clipboard",
    "notifications"
  ],
  "settings": {
    "dock.top_bar.visible": "true",
    "appearance.animations": "true",
    "appearance.animations.elastic": "false",
    "appearance.windows.rounded": "false",
    "appearance.background.type": "Image",
    "appearance.wallpaper.mode": "Crop",
    "dock.position": "Bottom",
    "dock.style": "Compact dock",
    "desktop.activities_button.position": "Left"
  },
  "background": {
    "type": "image",
    "source": "/usr/share/ricewm/wallpapers/afterburn-signal-yellow.svg",
    "mode": "Crop"
  },
  "overrides": {},
  "quickMenu": {
    "applications": "list",
    "density": "compact",
    "font": "monospace",
    "width": 840
  },
  "surface": {
    "frame": "bracket",
    "edge": "#f4ef18",
    "cornerLength": 12,
    "inset": 2,
    "titleInk": "#e8eee6",
    "variant": "cyberpunk"
  },
  "widgets": [],
  "tiling": {
    "enabled": true,
    "arrangement": "Scrolling"
  },
