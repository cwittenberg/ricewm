{
  "$schema": "ricewm.theme/v2",
  "name": "Afterburn",
  "description": "Graphite industrial surfaces, precise accent lines and mechanical shutter motion. Four coordinated color palettes.",
  "appearance": {
    "taskbar.bar": "0c1015",
    "taskbar.ridge": "f4ef18",
    "taskbar.start": "f4ef18",
    "taskbar.task": "171e20",
