{
  "$schema": "ricewm.theme/v2",
  "name": "Common Oldfashioned",
  "description": "A complete Motif/CDE-inspired workstation theme: sculpted slate furniture, diamond radio buttons, recessed gold indicators, square switches, proportional arrow scrollbars, thick resize frames and a full-size regular desktop dock.",
  "appearance": {
    "chrome.profile": "familiar",
    "material": "solid",
    "corner.radius": "0",
    "button.style": "default",
    "window.shape": "default",
    "control.layout": "split",
    "panel.position": "bottom",
    "sidebar.material": "solid",
    "menu.material": "solid",
    "taskbar.bar": "9297ab",
    "taskbar.ridge": "d8dbe5",
    "taskbar.start": "aeb0c3",
    "taskbar.task": "aeb0c3",
    "taskbar.tray": "81869d",
    "taskbar.text": "161824",
    "accent": "5b6388",
    "icon": "202334",
    "icon.hover": "202334",
    "icon.variant": "color",
    "icon.overrides": "",
    "menu.background": "aeb0c3",
    "menu.alternate": "b8becb",
    "menu.separator": "62677f",
    "menu.hover": "9297ab",
    "menu.selected": "9297ab",
    "menu.text": "161824",
    "frame.active": "584d8b",
    "frame.inactive": "a0a2b5",
    "frame.border": "41465d",
    "frame.body": "aeb0c3",
    "frame.text": "fff7e8",
    "frame.control": "584d8b",
    "frame.close": "584d8b",
    "frame.pressed": "525a7b"
  },
  "version": 1,
  "background": {
    "type": "image",
    "source": "/usr/share/ricewm/wallpapers/common-oldfashioned-embossed.svg",
    "mode": "Tile"
  },
  "wallpapers": [
    {
      "id": "common-oldfashioned-embossed",
      "name": "Embossed RiceWM",
      "source": "/usr/share/ricewm/wallpapers/common-oldfashioned-embossed.svg",
      "type": "image",
      "mode": "Tile",
      "credit": "Original RiceWM artwork; CC0-1.0"
    }
  ],
  "defaultWallpaper": "common-oldfashioned-embossed",
  "typography": {
    "family": "classic",
    "titleFamily": "classic",
    "bodyPx": 13,
    "smallPx": 12,
    "titlePx": 14,
    "bodyWeight": 400,
    "titleWeight": 400
  },
  "metrics": {
    "titlebarHeight": 30,
    "controlHeight": 26,
    "menuRowHeight": 26,
    "scrollbarWidth": 20,
    "borderWidth": 1,
    "cornerRadius": 0,
    "focusWidth": 1,
    "controlPaddingX": 9,
    "controlPaddingY": 4,
    "scrollbarArrowSize": 20,
    "scrollbarArrowPlacement": 0,
    "scrollbarThumbMin": 24,
    "scrollbarInset": 0,
    "sliderTrackHeight": 8,
    "sliderThumbWidth": 28,
    "sliderThumbHeight": 20,
    "checkboxSize": 18,
    "radioSize": 20,
    "choiceGap": 7,
    "checkboxGlyphInset": 4,
    "radioGlyphInset": 4,
    "switchWidth": 42,
    "switchHeight": 22,
    "switchThumbWidth": 20,
    "switchThumbHeight": 18,
    "switchInset": 2,
    "switchGap": 7,
    "tabHeight": 28,
    "tabPaddingX": 12,
    "tabGap": 3,
    "tabRecess": 4
  },
  "windowDecorations": {
    "controlLayout": "split",
    "controlOrder": [
      "menu",
      "minimize",
      "maximize"
    ],
    "frameInsets": [
      5,
      5,
      5,
      5
    ],
    "clientRecess": 0,
    "resizeGripLength": 30,
    "resizeGripThickness": 2,
    "titleAlignment": "center",
    "showTitleIcon": false,
    "frameBorderWidth": 1,
    "captionWidth": 24,
    "captionHeight": 24,
    "captionGap": 2,
    "captionRadius": 0,
    "controlBoxEdgeInset": 1,
    "glyphStyle": "beveled",
    "glyphWidth": 12,
    "glyphHeight": 12
  },
