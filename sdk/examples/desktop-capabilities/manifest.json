    "bus": {
      "subscribe": ["dev.herdr.generated.sdk-capabilities/notifications/action", "dev.herdr.generated.sdk-capabilities/calendar/changed", "dev.herdr.generated.sdk-capabilities/hotkeys/activated", "dev.herdr.generated.sdk-capabilities/actions/invoke", "dev.herdr.generated.sdk-capabilities/plugins/invoke"]
    }
