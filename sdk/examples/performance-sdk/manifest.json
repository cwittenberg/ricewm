{
  "sdk": { "version": "1.0.0" },
  "schema": "ricewm.app/v1",
  "id": "dev.ricewm.performance-sdk",
  "name": "System Monitor",
  "version": "3.0.3",
  "description": "Live workspace dashboard with interactive resource charts, utilization gauges, network rates and storage insights.",
  "entry": "app.mjs",
  "window": {
    "profile": "system-monitor",
    "width": 1100,
    "height": 660
  },
  "categories": [
    "System",
    "Utility"
  ],
  "permissions": {
    "services": [
      "files.read",
      "clipboard.writeText",
      "files.write",
      "applications.launch",
      "system.info",
      "system.performance",
      "system.processSignal",
      "system.processNice"
    ],
    "bus": {}
  },
  "sdk": {
    "version": "1.0.0"
  }
}
